        "content": [
          {
            "type": "output_text",
            "text": "Checking."
          }
        ]
      },
      {
        "type": "function_call",
        "call_id": "call_A",
        "name": "get_weather",
        "arguments": "{\"city\":\"Paris\"}"
      },
      {
        "type": "function_call_output",
        "call_id": "call_A",
        "output": "18C"
