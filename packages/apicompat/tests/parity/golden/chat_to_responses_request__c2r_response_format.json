{
  "direction": "chat_to_responses_request",
  "input": {
    "model": "gpt-4o",
    "messages": [
      {
        "role": "user",
        "content": "Hello"
      }
    ],
    "max_tokens": 100,
    "response_format": {
      "type": "json_object"
    },
    "stream": true
  },
  "name": "c2r_response_format",
  "output": {
    "model": "gpt-4o",
    "input": [
      {
        "type": "message",
        "role": "user",
        "content": "Hello"
      }
    ],
    "max_output_tokens": 128,
    "stream": true,
    "include": [
      "reasoning.encrypted_content"
    ],
    "store": false,
    "text": {
      "format": {
        "type": "json_object"
      }
    }
  }
}